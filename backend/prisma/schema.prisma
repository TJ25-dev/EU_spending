// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Contract {
  id              String    @id
  tedNoticeId     String    @unique

  // Core contract info
  title           String
  description     String
  amount          Float
  currency        String    @default("EUR")
  publishDate     DateTime
  deadline        DateTime?

  // Location
  country         String
  countryCode     String
  nuts            String?
  region          String?
  city            String?
  lat             Float?
  lng             Float?

  // Parties
  buyerName       String
  buyerType       String?
  contractorName  String?

  // Classification
  cpvCode         String?
  cpvDescription  String?
  procedureType   String?
  noticeType      String?

  // Tracking
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  firstSeenAt     DateTime  @default(now())

  // X/Twitter posting
  postedToX       Boolean   @default(false)
  postedToXAt     DateTime?
  xPostId         String?

  // Noteworthy flags (for X posting logic)
  isNoteworthy    Boolean   @default(false)
  noteworthyReason String?

  @@index([country])
  @@index([countryCode])
  @@index([publishDate])
  @@index([amount])
  @@index([cpvCode])
  @@index([postedToX])
  @@index([isNoteworthy])
  @@index([createdAt])
}

model SyncState {
  id              String    @id @default("default")
  lastSyncAt      DateTime?
  lastSyncCount   Int       @default(0)
  lastSyncDuration Float?   // in seconds
  isRunning       Boolean   @default(false)
  startedAt       DateTime?
  error           String?

  updatedAt       DateTime  @updatedAt
}

model XPostQueue {
  id              String    @id @default(cuid())
  contractId      String
  scheduledFor    DateTime?
  status          String    @default("pending") // pending, posted, failed
  attempts        Int       @default(0)
  lastAttemptAt   DateTime?
  error           String?
  xPostId         String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([scheduledFor])
}
